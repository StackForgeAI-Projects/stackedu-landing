# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design reference (Lovable export — not part of production site)
/stackedu-design/
/stackforgenext-main/

# EMS monorepo — secrets and local artifacts (also covered by app/.gitignore)
/app/.env
/app/.env.local
/app/.data/
/app/node_modules/
/app/**/node_modules/
/app/**/dist/
/app/**/.turbo/

# editor / IDE
.cursor/
.vscode/
.idea/

# OS
Thumbs.db

# Office lock files
~\$*

# Local planning docs — keep off the main repo
/docs/
