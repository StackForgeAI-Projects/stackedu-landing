{
  "name": "stackedu",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "db:up": "docker compose up -d && docker compose exec -T postgres sh -c 'until pg_isready -U stackedu -q; do sleep 1; done'",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && bun run db:up",
    "db:generate": "bun run --filter '@stackedu/api' db:generate",
    "db:migrate": "bun run --filter '@stackedu/api' db:migrate",
    "db:seed": "bun run --filter '@stackedu/api' db:seed",
    "institution:create": "bun run --filter '@stackedu/api' institution:create"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.8"
  }
}
