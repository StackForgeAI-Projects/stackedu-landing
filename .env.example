# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Recipient for demo/contact form submissions
CONTACT_TO_EMAIL=hello@stackedu.africa

# Verified sender in Resend (use onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=StackEDU <onboarding@resend.dev>

# Cloudinary (public values only — never put API secret in NEXT_PUBLIC_*)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Public ID only from Media Library (NOT a full https:// URL)
NEXT_PUBLIC_HERO_VIDEO_ID=stackedu/hero-demo
# Optional: paste a full delivery URL instead (also accepted if put in HERO_VIDEO_ID by mistake)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://res.cloudinary.com/your_cloud_name/video/upload/v123/stackedu/hero-demo.mp4
